{
  "name": "@alexeyco/pi-statusline",
  "version": "0.2.0",
  "description": "Compact footer for the pi coding agent — model/thinking and context usage on the left, MCP server count on the right, extension statuses below",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "statusline",
    "statusbar",
    "tui"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexeyco/pi-statusline.git"
  },
  "scripts": {
    "test": "node --test src/status.test.ts",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.2",
    "@earendil-works/pi-coding-agent": "^1.0.2",
    "@earendil-works/pi-tui": "^1.0.2",
    "@types/node": "^26.0.0",
    "typescript": "^5.9.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/alexeyco/pi-statusline/master/docs/gallery/terminal.png"
  },
  "publishConfig": {
    "access": "public"
  }
}
