{
  "name": "@alexeyco/pi-statusline",
  "version": "0.1.0",
  "description": "Compact statusline for the pi coding agent — model/thinking on the editor border, single-line footer with token totals and context usage",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "statusline",
    "statusbar",
    "tui"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexeyco/pi-statusline.git"
  },
  "scripts": {
    "test": "node --test src/status.test.ts",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^26.0.0",
    "typescript": "^5.9.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/alexeyco/pi-statusline/master/docs/gallery/terminal.png"
  },
  "publishConfig": {
    "access": "public"
  }
}
